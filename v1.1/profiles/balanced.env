# Balanced — daily development (default)
PROFILE_NAME="Balanced"
PROFILE_TAGLINE="Daily dev work — best compromise"
PROFILE_BATTERY_HOURS="~3–4 hours"

PRIME_MODE="on-demand"
NVREG_DPM="0x02"
NVIDIA_RUNTIME_PM="auto"

CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_BAT=power
CPU_MAX_PERF_ON_BAT=35
CPU_BOOST_ON_BAT=0
CPU_HWP_DYN_BOOST_ON_BAT=0
PLATFORM_PROFILE_ON_BAT=low-power

INTEL_GPU_MAX_FREQ_ON_BAT=300
INTEL_GPU_BOOST_FREQ_ON_BAT=450

NVME_POWER_MGMT_ON_BAT=med_power_with_dipm
SATA_LINKPWR_ON_BAT=min_power
PCIE_ASPM_ON_BAT=powersupersave
WIFI_PWR_ON_BAT=on

BRIGHTNESS_CAP_ENABLED=1
BRIGHTNESS_CAP_PCT=40

CHARGE_START=40
CHARGE_STOP=80

DOCKER_ON_BATTERY=warn
VM_LAPTOP_MODE=5
DISK_IDLE_SECS_ON_BAT=2
MAX_LOST_WORK_SECS_ON_BAT=60
DEVICES_DISABLE_BAT="bluetooth nfc ethernet"

I915_ENABLE_PSR=2
I915_ENABLE_FBC=1
GRUB_PCIE_ASPM=force

EXPECTED_PRIME_MODE="on-demand"
BIOS_GRAPHICS_HINT="Integrated Only"

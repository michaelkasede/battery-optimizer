# Gaming — discrete GPU dedicated, AC-powered
PROFILE_NAME="Gaming"
PROFILE_TAGLINE="Steam and GPU games — plug in AC adapter"
PROFILE_BATTERY_HOURS="AC required — ~45 min if unplugged"

PRIME_MODE="nvidia"
NVREG_DPM="0x00"
NVIDIA_RUNTIME_PM="on"

CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_power
CPU_MAX_PERF_ON_BAT=40
CPU_BOOST_ON_BAT=0
CPU_HWP_DYN_BOOST_ON_BAT=0
PLATFORM_PROFILE_ON_BAT=balanced

CPU_SCALING_GOVERNOR_ON_AC=performance
CPU_ENERGY_PERF_POLICY_ON_AC=performance
CPU_MAX_PERF_ON_AC=100
CPU_BOOST_ON_AC=1
CPU_HWP_DYN_BOOST_ON_AC=1
PLATFORM_PROFILE_ON_AC=performance

INTEL_GPU_MAX_FREQ_ON_BAT=0
INTEL_GPU_BOOST_FREQ_ON_BAT=0

NVME_POWER_MGMT_ON_BAT=med_power_with_dipm
NVME_POWER_MGMT_ON_AC=off
SATA_LINKPWR_ON_BAT=med_power_with_dipm
SATA_LINKPWR_ON_AC=med_power_with_dipm
PCIE_ASPM_ON_BAT=default
PCIE_ASPM_ON_AC=default
WIFI_PWR_ON_BAT=off
WIFI_PWR_ON_AC=off

BRIGHTNESS_CAP_ENABLED=0
BRIGHTNESS_CAP_PCT=0

CHARGE_START=20
CHARGE_STOP=100

DOCKER_ON_BATTERY=ignore
VM_LAPTOP_MODE=0
DISK_IDLE_SECS_ON_BAT=0
MAX_LOST_WORK_SECS_ON_BAT=15
DEVICES_DISABLE_BAT=""

I915_ENABLE_PSR=-1   # driver default
I915_ENABLE_FBC=-1   # driver default (forced FBC can cause flicker)
GRUB_PCIE_ASPM=default   # TLP sets ASPM policy; force is unsafe

EXPECTED_PRIME_MODE="nvidia"
BIOS_GRAPHICS_HINT="Hybrid or Discrete"

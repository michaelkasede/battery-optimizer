# Performance — heavy workloads on battery
PROFILE_NAME="Performance"
PROFILE_TAGLINE="Maximum responsiveness on battery"
PROFILE_BATTERY_HOURS="~1.5–2 hours"

PRIME_MODE="on-demand"
NVREG_DPM="0x02"
NVIDIA_RUNTIME_PM="auto"

CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_performance
CPU_MAX_PERF_ON_BAT=80
CPU_BOOST_ON_BAT=1
CPU_HWP_DYN_BOOST_ON_BAT=1
PLATFORM_PROFILE_ON_BAT=performance

INTEL_GPU_MAX_FREQ_ON_BAT=0
INTEL_GPU_BOOST_FREQ_ON_BAT=0

NVME_POWER_MGMT_ON_BAT=med_power_with_dipm
SATA_LINKPWR_ON_BAT=med_power_with_dipm
PCIE_ASPM_ON_BAT=default
WIFI_PWR_ON_BAT=off

BRIGHTNESS_CAP_ENABLED=0
BRIGHTNESS_CAP_PCT=0

CHARGE_START=20
CHARGE_STOP=100

DOCKER_ON_BATTERY=warn
VM_LAPTOP_MODE=3
DISK_IDLE_SECS_ON_BAT=2
MAX_LOST_WORK_SECS_ON_BAT=30
DEVICES_DISABLE_BAT="bluetooth nfc"

I915_ENABLE_PSR=-1   # driver default
I915_ENABLE_FBC=-1   # driver default (forced FBC can cause flicker)
GRUB_PCIE_ASPM=default   # TLP sets ASPM policy; force is unsafe

EXPECTED_PRIME_MODE="on-demand"
BIOS_GRAPHICS_HINT="Integrated Only"
